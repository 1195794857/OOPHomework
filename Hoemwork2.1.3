#include <iostream>
#include <iomanip>
#include <string>
using namespace std;

// 内联函数：计算平方
inline double square(double x) {
	return x * x;
}

// 带默认参数：默认计算平方
double power(double base, int exponent = 2) {
	double result = 1.0;

	for (int i = 0; i < exponent; ++i) {
		result *= base;
	}

	return result;
}

// double 版本重载函数
double calc(double a, double b, char op) {
	switch (op) {
	case '+':
		return a + b;
	case '-':
		return a - b;
	case '*':
		return a * b;
	case '/':
		if (b == 0.0) {
			cout << "Error: divide by zero" << endl;
			return 0.0;
		}
		return a / b;
	default:
		cout << "Error: unknown operator" << endl;
		return 0.0;
	}
}

// int 版本重载函数
double calc(int a, int b, char op) {
	switch (op) {
	case '+':
		return a + b;
	case '-':
		return a - b;
	case '*':
		return a * b;
	case '/':
		if (b == 0) {
			cout << "Error: divide by zero" << endl;
			return 0.0;
		}
		return static_cast<double>(a) / b;
	default:
		cout << "Error: unknown operator" << endl;
		return 0.0;
	}
}

int main() {
	string sa, sb;
	char op;

	cin >> sa >> sb >> op;

	double a = stod(sa);
	double b = stod(sb);

	cout << "square(" << sa << ") = "
		<< fixed << setprecision(2) << square(a) << endl;

	cout << "power(" << sa << ",3) = "
		<< fixed << setprecision(2) << power(a, 3) << endl;

	if (op == '/' && b == 0.0) {
		calc(a, b, op);
	}
	else {
		cout << sa << " " << op << " " << sb << " = "
			<< fixed << setprecision(2) << calc(a, b, op) << endl;
	}

	return 0;
}
